---
source: src/views/slots.rs
expression: "slots_section(&every_state(),\n&empty_plan_form()).into_string().replace(\"><\", \">\\n<\")"
---
<section class="section slots" aria-labelledby="slots">
<h2 id="slots">Brewing slots</h2>
<ul class="slot-list">
<li class="slot passed">
<span class="slot-main">
<span class="slot-date">
<time datetime="2026-11-01">Sun 1 Nov</time>
</span>
<span class="slot-ask">Did you brew?</span>
<span class="slot-batch">
<a href="/batches/13">#13 Desítka</a>
</span>
</span>
<span class="slot-actions">
<a class="button small" href="/batches/13/brew-day?date=2026-11-01">Pick the Batch</a>
<a class="button secondary small" href="/batches/slots/1">Move</a>
<form method="post" action="/batches/slots/1/cancel" hx-post="/batches/slots/1/cancel" hx-confirm="Cancel the slot on Sun 1 Nov? The day is no longer set aside for brewing.">
<button class="button danger small" type="submit">Cancel</button>
</form>
</span>
</li>
<li class="slot passed">
<span class="slot-main">
<span class="slot-date">
<time datetime="2026-11-08">Sun 8 Nov</time>
</span>
<span class="slot-ask">Did you brew?</span>
<span class="slot-batch">Nothing chosen yet</span>
</span>
<span class="slot-actions">
<a class="button small" href="/batches/slots/2">Pick the Batch</a>
<a class="button secondary small" href="/batches/slots/2">Move</a>
<form method="post" action="/batches/slots/2/cancel" hx-post="/batches/slots/2/cancel" hx-confirm="Cancel the slot on Sun 8 Nov? The day is no longer set aside for brewing.">
<button class="button danger small" type="submit">Cancel</button>
</form>
</span>
</li>
<li class="slot">
<span class="slot-main">
<span class="slot-date">
<time datetime="2026-11-11">Wed 11 Nov</time>
</span>
<span class="slot-batch">Nothing chosen yet</span>
</span>
<span class="slot-actions">
<a class="button secondary small" href="/batches/slots/5#slot-batch">Pick a Batch</a>
<a class="button secondary small" href="/batches/slots/5">Move</a>
<form method="post" action="/batches/slots/5/cancel" hx-post="/batches/slots/5/cancel" hx-confirm="Cancel the slot on Wed 11 Nov? The day is no longer set aside for brewing.">
<button class="button danger small" type="submit">Cancel</button>
</form>
</span>
</li>
<li class="slot">
<span class="slot-main">
<span class="slot-date">
<time datetime="2026-11-21">Sat 21 Nov</time>
</span>
<span class="slot-batch">
<a href="/batches/14">#14 Vzor 10°</a>
</span>
</span>
<span class="slot-actions">
<form method="post" action="/batches/slots/3/unlink">
<button class="button secondary small" type="submit">Unlink</button>
</form>
<a class="button secondary small" href="/batches/slots/3">Move</a>
<form method="post" action="/batches/slots/3/cancel" hx-post="/batches/slots/3/cancel" hx-confirm="Cancel the slot on Sat 21 Nov? The day is no longer set aside for brewing.">
<button class="button danger small" type="submit">Cancel</button>
</form>
</span>
</li>
</ul>
<form class="entry-form slot-form" id="plan-slot" method="post" action="/batches/slots" hx-post="/batches/slots" hx-swap="outerHTML">
<div class="field">
<label for="slot-date">Date</label>
<input id="slot-date" type="date" name="date" value="" min="2026-11-11" required>
</div>
<button class="button" type="submit">Plan a slot</button>
</form>
</section>
