---
source: src/views/quotes.rs
expression: "empty_form().into_string().replace(\"><\", \">\\n<\")"
---
<form class="entry-form" method="post" action="/quotes" hx-post="/quotes" hx-target="#quote-adder" hx-swap="innerHTML">
<div class="field">
<label for="quote-text">Quote</label>
<textarea id="quote-text" name="text" rows="4" required maxlength="2000">
</textarea>
</div>
<div class="field">
<label for="quote-author">Author</label>
<input id="quote-author" type="text" name="author" value="" required maxlength="100" list="quote-authors">
<datalist id="quote-authors">
<option value="Josef">
</option>
<option value="Ondra">
</option>
<option value="Šimon">
</option>
</datalist>
</div>
<button class="button large" type="submit">Add Quote</button>
</form>
