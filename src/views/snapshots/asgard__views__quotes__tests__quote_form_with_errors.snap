---
source: src/views/quotes.rs
expression: "form(values, &problems, &authors()).into_string().replace(\"><\", \">\\n<\")"
---
<form class="entry-form" method="post" action="/quotes" hx-post="/quotes" hx-target="#quote-adder" hx-swap="innerHTML">
<div class="field">
<label for="quote-text">Quote</label>
<textarea id="quote-text" name="text" rows="4" required maxlength="2000" aria-invalid="true" aria-describedby="quote-text-problem">He said
it twice</textarea>
<p class="field-problem" id="quote-text-problem">Keep the Quote to 2000 characters or fewer.</p>
</div>
<div class="field">
<label for="quote-author">Author</label>
<input id="quote-author" type="text" name="author" value=" " required maxlength="100" list="quote-authors" aria-invalid="true" aria-describedby="quote-author-problem">
<datalist id="quote-authors">
<option value="Josef">
</option>
<option value="Ondra">
</option>
<option value="Šimon">
</option>
</datalist>
<p class="field-problem" id="quote-author-problem">Say who said it.</p>
</div>
<button class="button large" type="submit">Add Quote</button>
</form>
