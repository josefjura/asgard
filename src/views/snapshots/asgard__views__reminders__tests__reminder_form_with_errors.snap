---
source: src/views/reminders.rs
expression: "form(values, &problems, NOW).into_string().replace(\"><\", \">\\n<\")"
---
<form class="entry-form" method="post" action="/reminders" hx-post="/reminders" hx-swap="outerHTML">
<div class="field">
<label for="reminder-text">What to remember</label>
<input id="reminder-text" type="text" name="text" value="" required maxlength="500" autocomplete="off" aria-invalid="true" aria-describedby="reminder-text-problem">
<p class="field-problem" id="reminder-text-problem">Say what to remember.</p>
</div>
<div class="field">
<label for="reminder-due">Due, Prague time</label>
<input id="reminder-due" type="datetime-local" name="due_at" value="2026-10-23T18:00" min="2026-10-24T10:00" required aria-invalid="true" aria-describedby="reminder-due-problem">
<p class="field-problem" id="reminder-due-problem">Pick a time that hasn't passed yet.</p>
</div>
<button class="button large" type="submit">Create Reminder</button>
</form>
