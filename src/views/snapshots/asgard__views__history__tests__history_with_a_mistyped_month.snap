---
source: src/views/history.rs
expression: "page(&member(JOSEF), &crew(), &filters,\n&unfiltered(),).into_string().replace(\"><\", \">\\n<\")"
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Finance | Asgard</title>
<meta name="theme-color" content="#3E5B2B" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#263820" media="(prefers-color-scheme: dark)">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="Asgard">
<link rel="manifest" href="/manifest.webmanifest">
<link rel="icon" type="image/svg+xml" href="/static/icon.[hash].svg">
<link rel="apple-touch-icon" href="/static/apple-touch-icon.[hash].png">
<link rel="stylesheet" href="/static/app.[hash].css">
<meta name="htmx-config" content="{&quot;responseHandling&quot;:[{&quot;code&quot;:&quot;204&quot;,&quot;swap&quot;:false},{&quot;code&quot;:&quot;[23]..&quot;,&quot;swap&quot;:true},{&quot;code&quot;:&quot;422&quot;,&quot;swap&quot;:true},{&quot;code&quot;:&quot;[45]..&quot;,&quot;swap&quot;:false,&quot;error&quot;:true},{&quot;code&quot;:&quot;...&quot;,&quot;swap&quot;:false}]}">
<script src="/static/htmx-2.0.11.min.[hash].js" defer>
</script>
<script type="module" src="/static/register-sw.[hash].js">
</script>
</head>
<body>
<div class="shell">
<header class="shell-header">
<a class="logo" href="/">
<img src="/static/logo-header.[hash].svg" alt="Asgard" width="128" height="32">
</a>
<a class="settings-link" href="/settings" aria-label="Settings">
<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
<circle cx="12" cy="12" r="3">
</circle>
<path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z">
</path>
</svg>
</a>
</header>
<main class="shell-main">
<h1>History</h1>
<form class="history-filters" method="get" action="/history">
<div class="field">
<label for="history-member">Member</label>
<select id="history-member" name="member">
<option value="" selected>Everyone</option>
<option value="1">Josef</option>
<option value="2">Ondra</option>
<option value="3">Šimon</option>
</select>
</div>
<div class="field">
<label for="history-month">Month</label>
<input id="history-month" type="month" name="month" value="Oct" placeholder="YYYY-MM" aria-invalid="true" aria-describedby="history-month-problem">
<p class="field-problem" id="history-month-problem">Enter a month as YYYY-MM, like 2026-10.</p>
</div>
<div class="history-filter-actions">
<button class="button" type="submit">Show</button>
<a class="button secondary" href="/history">Clear</a>
</div>
</form>
<section class="section" aria-labelledby="history-entries">
<h2 id="history-entries">Entries</h2>
<ul class="entry-list">
<li class="entry payment">
<div class="entry-main">
<span class="entry-what" id="payment-4">Josef → Ondra</span>
<span class="entry-meta">Payment · 29 October 2026</span>
<div class="entry-controls">
<a class="button secondary small" href="/payments/4/edit?back=%2Fhistory" aria-describedby="payment-4">Edit</a>
<form method="post" action="/payments/4/delete?back=%2Fhistory" hx-post="/payments/4/delete?back=%2Fhistory" hx-confirm="Delete the Payment from Josef to Ondra?">
<button class="button danger small" type="submit" aria-describedby="payment-4">Delete</button>
</form>
</div>
</div>
<span class="entry-amount">4 160 Kč</span>
</li>
<li class="entry">
<div class="entry-main">
<span class="entry-what" id="expense-7">Pilsner malt, 3 sacks, and a new hydrometer</span>
<span class="entry-meta">Ondra paid · 28 October 2026</span>
<div class="entry-controls">
<a class="button secondary small" href="/expenses/7/edit?back=%2Fhistory" aria-describedby="expense-7">Edit</a>
<form method="post" action="/expenses/7/delete?back=%2Fhistory" hx-post="/expenses/7/delete?back=%2Fhistory" hx-confirm="Delete the Expense “Pilsner malt, 3 sacks, and a new hydrometer”?">
<button class="button danger small" type="submit" aria-describedby="expense-7">Delete</button>
</form>
</div>
</div>
<span class="entry-amount">12 480 Kč</span>
</li>
<li class="entry">
<div class="entry-main">
<span class="entry-what" id="expense-6">Saaz hops</span>
<span class="entry-meta">Šimon paid · 21 October 2026</span>
<div class="entry-controls">
<a class="button secondary small" href="/expenses/6/edit?back=%2Fhistory" aria-describedby="expense-6">Edit</a>
<form method="post" action="/expenses/6/delete?back=%2Fhistory" hx-post="/expenses/6/delete?back=%2Fhistory" hx-confirm="Delete the Expense “Saaz hops”?">
<button class="button danger small" type="submit" aria-describedby="expense-6">Delete</button>
</form>
</div>
</div>
<span class="entry-amount">380 Kč</span>
</li>
<li class="entry">
<div class="entry-main">
<span class="entry-what" id="expense-5">Bottle caps and sanitiser</span>
<span class="entry-meta">Josef paid · 2 October 2026</span>
<div class="entry-controls">
<a class="button secondary small" href="/expenses/5/edit?back=%2Fhistory" aria-describedby="expense-5">Edit</a>
<form method="post" action="/expenses/5/delete?back=%2Fhistory" hx-post="/expenses/5/delete?back=%2Fhistory" hx-confirm="Delete the Expense “Bottle caps and sanitiser”?">
<button class="button danger small" type="submit" aria-describedby="expense-5">Delete</button>
</form>
</div>
</div>
<span class="entry-amount">1 240 Kč</span>
</li>
</ul>
<nav class="pages" aria-label="Pages">
<span class="pages-at">Page 1 of 3</span>
<a class="button secondary small" rel="next" href="/history?page=2">Older</a>
</nav>
</section>
<section class="section" aria-labelledby="monthly-totals">
<h2 id="monthly-totals">Monthly totals</h2>
<table class="monthly-totals">
<thead>
<tr>
<th scope="col">Month</th>
<th scope="col">Expenses</th>
<th scope="col">Payments</th>
</tr>
</thead>
<tbody>
<tr>
<th scope="row">
<a href="/history?month=2026-10">October 2026</a>
</th>
<td>14 100 Kč</td>
<td>4 160 Kč</td>
</tr>
<tr>
<th scope="row">
<a href="/history?month=2026-09">September 2026</a>
</th>
<td>2 315 Kč</td>
<td>0 Kč</td>
</tr>
<tr>
<th scope="row">
<a href="/history?month=2026-08">August 2026</a>
</th>
<td>38 900 Kč</td>
<td>12 000 Kč</td>
</tr>
</tbody>
</table>
</section>
</main>
<nav class="tabs" aria-label="Sections">
<a class="tab" href="/" aria-current="page">
<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
<ellipse cx="12" cy="6" rx="7" ry="3">
</ellipse>
<path d="M5 6v6c0 1.7 3.1 3 7 3s7-1.3 7-3V6">
</path>
<path d="M5 12v6c0 1.7 3.1 3 7 3s7-1.3 7-3v-6">
</path>
</svg>
<span>Finance</span>
</a>
<a class="tab" href="/shopping">
<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
<path d="M3 4h2l2.4 11h10.2L20 8H6.2">
</path>
<circle cx="9" cy="19.5" r="1.5">
</circle>
<circle cx="17" cy="19.5" r="1.5">
</circle>
</svg>
<span>Shopping</span>
</a>
<a class="tab" href="/reminders">
<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
<path d="M6 16v-5a6 6 0 0 1 12 0v5l2 2H4z">
</path>
<path d="M10 20.5a2 2 0 0 0 4 0">
</path>
</svg>
<span>Reminders</span>
</a>
<a class="tab" href="/quotes">
<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
<path d="M4 5h16v11H9l-5 4z">
</path>
</svg>
<span>Quotes</span>
</a>
</nav>
</div>
</body>
</html>
