---
source: src/views/slots.rs
expression: "slots_section(&several(),\n&empty_plan_form()).into_string().replace(\"><\", \">\\n<\")"
---
<section class="section slots" aria-labelledby="slots">
<h2 id="slots">Brewing slots</h2>
<ul class="slot-list">
<li class="slot">
<span class="slot-main">
<span class="slot-date">
<time datetime="2026-11-11">Wed 11 Nov</time>
</span>
<span class="slot-batch">Nothing chosen yet</span>
</span>
<span class="slot-actions">
<a class="button secondary small" href="/batches/slots/5#slot-batch">Pick a Batch</a>
<a class="button secondary small" href="/batches/slots/5">Move</a>
<form method="post" action="/batches/slots/5/cancel" hx-post="/batches/slots/5/cancel" hx-confirm="Cancel the slot on Wed 11 Nov? The day is no longer set aside for brewing.">
<button class="button danger small" type="submit">Cancel</button>
</form>
</span>
</li>
<li class="slot">
<span class="slot-main">
<span class="slot-date">
<time datetime="2026-11-21">Sat 21 Nov</time>
</span>
<span class="slot-batch">Nothing chosen yet</span>
</span>
<span class="slot-actions">
<a class="button secondary small" href="/batches/slots/3#slot-batch">Pick a Batch</a>
<a class="button secondary small" href="/batches/slots/3">Move</a>
<form method="post" action="/batches/slots/3/cancel" hx-post="/batches/slots/3/cancel" hx-confirm="Cancel the slot on Sat 21 Nov? The day is no longer set aside for brewing.">
<button class="button danger small" type="submit">Cancel</button>
</form>
</span>
</li>
<li class="slot">
<span class="slot-main">
<span class="slot-date">
<time datetime="2026-12-05">Sat 5 Dec</time>
</span>
<span class="slot-batch">Nothing chosen yet</span>
</span>
<span class="slot-actions">
<a class="button secondary small" href="/batches/slots/4#slot-batch">Pick a Batch</a>
<a class="button secondary small" href="/batches/slots/4">Move</a>
<form method="post" action="/batches/slots/4/cancel" hx-post="/batches/slots/4/cancel" hx-confirm="Cancel the slot on Sat 5 Dec? The day is no longer set aside for brewing.">
<button class="button danger small" type="submit">Cancel</button>
</form>
</span>
</li>
</ul>
<form class="entry-form slot-form" id="plan-slot" method="post" action="/batches/slots" hx-post="/batches/slots" hx-swap="outerHTML">
<div class="field">
<label for="slot-date">Date</label>
<input id="slot-date" type="date" name="date" value="" min="2026-11-11" required>
</div>
<button class="button" type="submit">Plan a slot</button>
</form>
</section>
