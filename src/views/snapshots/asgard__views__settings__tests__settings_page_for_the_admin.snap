---
source: src/views/settings.rs
expression: "page(&display_name::form(\"/settings/name\", \"Josef\", None),\n&passkeys::list(BASE, &fixtures::one(), None), &add_passkey(),\nSome(ADMIN_HREF), \"/log-out\",).into_string().replace(\"><\", \">\\n<\")"
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Settings | Asgard</title>
<meta name="theme-color" content="#3E5B2B" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#263820" media="(prefers-color-scheme: dark)">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="Asgard">
<link rel="manifest" href="/manifest.webmanifest">
<link rel="icon" type="image/svg+xml" href="/static/icon.[hash].svg">
<link rel="apple-touch-icon" href="/static/apple-touch-icon.[hash].png">
<link rel="stylesheet" href="/static/app.[hash].css">
<meta name="htmx-config" content="{&quot;responseHandling&quot;:[{&quot;code&quot;:&quot;204&quot;,&quot;swap&quot;:false},{&quot;code&quot;:&quot;[23]..&quot;,&quot;swap&quot;:true},{&quot;code&quot;:&quot;422&quot;,&quot;swap&quot;:true},{&quot;code&quot;:&quot;[45]..&quot;,&quot;swap&quot;:false,&quot;error&quot;:true},{&quot;code&quot;:&quot;...&quot;,&quot;swap&quot;:false}]}">
<script src="/static/htmx-2.0.11.min.[hash].js" defer>
</script>
<script type="module" src="/static/register-sw.[hash].js">
</script>
</head>
<body>
<div class="shell">
<header class="shell-header">
<a class="logo" href="/">
<img src="/static/logo-header.[hash].svg" alt="Asgard" width="128" height="32">
</a>
<a class="settings-link" href="/settings" aria-label="Settings" aria-current="page">
<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
<circle cx="12" cy="12" r="3">
</circle>
<path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z">
</path>
</svg>
</a>
</header>
<main class="shell-main">
<h1>Settings</h1>
<section class="settings-section" aria-labelledby="settings-name">
<h2 id="settings-name">Your name</h2>
<form class="name-form" method="post" action="/settings/name" hx-post="/settings/name" hx-swap="outerHTML">
<label for="display-name">Display name</label>
<div class="field-row">
<input id="display-name" type="text" name="display_name" value="Josef" required autocomplete="nickname" aria-describedby="display-name-note">
<button class="button" type="submit">Save</button>
</div>
<p class="note" id="display-name-note" role="status">This is how the Crew sees you.</p>
</form>
</section>
<section class="settings-section" aria-labelledby="settings-passkeys">
<h2 id="settings-passkeys">Passkeys</h2>
<div class="passkeys" id="passkeys">
<ul class="passkey-list">
<li class="passkey">
<form class="passkey-rename" method="post" action="/settings/passkeys/1/name" hx-post="/settings/passkeys/1/name" hx-target="#passkeys" hx-swap="outerHTML">
<label for="passkey-1-name">Passkey added 14 March 2026</label>
<div class="field-row">
<input id="passkey-1-name" type="text" name="name" value="iPhone Safari" required autocomplete="off">
<button class="button" type="submit">Rename</button>
</div>
</form>
</li>
</ul>
<p class="note" role="status">Your only passkey can't be deleted. Add another one first.</p>
</div>
<p class="lead-in">Add a passkey on each device you sign in from, unless your passkeys already sync to it.</p>
<button class="button" type="button" data-passkey="register" data-passkey-start="/settings/passkeys/start" data-passkey-finish="/settings/passkeys/finish" aria-describedby="passkey-status">Add a passkey</button>
<p class="status" id="passkey-status" role="status">
</p>
<script type="module" src="/static/passkey.[hash].js">
</script>
</section>
<section class="settings-section" aria-labelledby="settings-push">
<h2 id="settings-push">Notifications</h2>
<div class="placeholder" id="push-control">Turning on notifications for this device is coming soon.</div>
</section>
<section class="settings-section" aria-labelledby="settings-admin">
<h2 id="settings-admin">Admin</h2>
<p class="lead-in">Bring someone into the Crew with an Invite link.</p>
<a class="button" href="/admin">Invite links</a>
</section>
<section class="settings-section" aria-labelledby="settings-device">
<h2 id="settings-device">This device</h2>
<p>Logging out signs this device out. Your passkey stays, so you can sign back in.</p>
<form method="post" action="/log-out">
<button class="button" type="submit">Log out</button>
</form>
</section>
</main>
<nav class="tabs" aria-label="Sections">
<a class="tab" href="/">
<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
<ellipse cx="12" cy="6" rx="7" ry="3">
</ellipse>
<path d="M5 6v6c0 1.7 3.1 3 7 3s7-1.3 7-3V6">
</path>
<path d="M5 12v6c0 1.7 3.1 3 7 3s7-1.3 7-3v-6">
</path>
</svg>
<span>Finance</span>
</a>
<a class="tab" href="/shopping">
<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
<path d="M3 4h2l2.4 11h10.2L20 8H6.2">
</path>
<circle cx="9" cy="19.5" r="1.5">
</circle>
<circle cx="17" cy="19.5" r="1.5">
</circle>
</svg>
<span>Shopping</span>
</a>
<a class="tab" href="/reminders">
<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
<path d="M6 16v-5a6 6 0 0 1 12 0v5l2 2H4z">
</path>
<path d="M10 20.5a2 2 0 0 0 4 0">
</path>
</svg>
<span>Reminders</span>
</a>
<a class="tab" href="/quotes">
<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
<path d="M4 5h16v11H9l-5 4z">
</path>
</svg>
<span>Quotes</span>
</a>
</nav>
</div>
</body>
</html>
