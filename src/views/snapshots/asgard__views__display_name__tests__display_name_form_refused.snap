---
source: src/views/display_name.rs
expression: "form(\"/welcome/name\", \"Josef\",\nSome(Outcome::Refused(\"Someone in the Crew is already called Josef.\"))).into_string().replace(\"><\",\n\">\\n<\")"
---
<form class="name-form" method="post" action="/welcome/name" hx-post="/welcome/name" hx-swap="outerHTML">
<label for="display-name">Display name</label>
<div class="field-row">
<input id="display-name" type="text" name="display_name" value="Josef" required autocomplete="nickname" aria-describedby="display-name-note" aria-invalid="true">
<button class="button secondary" type="submit">Save</button>
</div>
<p class="note refused" id="display-name-note" role="status">Someone in the Crew is already called Josef.</p>
</form>
