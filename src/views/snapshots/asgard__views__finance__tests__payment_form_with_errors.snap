---
source: src/views/finance.rs
expression: "payment_form(PAYMENT_ACTION, Purpose::Log, &crew(), &values,\n&problems).into_string().replace(\"><\", \">\\n<\")"
---
<form class="entry-form" method="post" action="/payments" hx-post="/payments" hx-swap="outerHTML">
<div class="field">
<label for="payment-amount">Amount in Kč</label>
<input id="payment-amount" type="text" inputmode="numeric" name="amount" value="0" required autocomplete="off" autofocus aria-invalid="true" aria-describedby="payment-amount-problem">
<p class="field-problem" id="payment-amount-problem">Enter an amount from 1 to 1 000 000 Kč.</p>
</div>
<div class="field">
<label for="payment-sender">Sent by</label>
<select id="payment-sender" name="sender">
<option value="1">Josef</option>
<option value="2">Ondra</option>
<option value="3" selected>Šimon</option>
</select>
</div>
<div class="field">
<label for="payment-recipient">Sent to</label>
<select id="payment-recipient" name="recipient" required aria-invalid="true" aria-describedby="payment-recipient-problem">
<option value="" disabled>Choose a Member</option>
<option value="1">Josef</option>
<option value="2">Ondra</option>
<option value="3" selected>Šimon</option>
</select>
<p class="field-problem" id="payment-recipient-problem">Choose someone other than the Sender.</p>
</div>
<div class="field">
<label for="payment-description">What for <span class="optional">(optional)</span>
</label>
<input id="payment-description" type="text" name="description" value="" maxlength="500" autocomplete="off">
</div>
<button class="button large" type="submit">Log Payment</button>
</form>
