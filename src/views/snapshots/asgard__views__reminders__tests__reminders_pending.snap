<body>
<div class="shell">
<header class="shell-header">
<a class="logo" href="/">
<img src="/static/logo-header.[hash].svg" alt="Asgard" width="128" height="32">
</a>
<a class="settings-link" href="/settings" aria-label="Settings">
<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
<circle cx="12" cy="12" r="3">
</circle>
<path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z">
</path>
</svg>
</a>
</header>
<main class="shell-main">
<h1>Reminders</h1>
<div class="columns">
<section class="section" aria-labelledby="new-reminder">
<h2 id="new-reminder">New Reminder</h2>
<p class="muted">The whole Crew is notified when it's due.</p>
<form class="entry-form" method="post" action="/reminders" hx-post="/reminders" hx-swap="outerHTML">
<div class="field">
<label for="reminder-text">What to remember</label>
<input id="reminder-text" type="text" name="text" value="" required maxlength="500" autocomplete="off">
</div>
<div class="field">
<label for="reminder-due">Due, Prague time</label>
<input id="reminder-due" type="datetime-local" name="due_at" value="" min="2026-10-24T10:00" required>
</div>
<button class="button large" type="submit">Create Reminder</button>
</form>
</section>
<section class="section" aria-labelledby="pending">
<h2 id="pending">Pending</h2>
<ul class="reminder-list">
<li class="reminder">
<span class="reminder-text" id="reminder-1">Bottle the stout</span>
<span class="reminder-meta">
<time datetime="2026-10-24T18:00">Saturday 24 October 2026, 18:00</time> · Josef</span>
</li>
<li class="reminder">
<span class="reminder-text" id="reminder-2">Order 25 kg of Pilsner malt and two packs of Saaz before the shop closes for the holidays</span>
<span class="reminder-meta">
<time datetime="2026-10-25T09:30">Sunday 25 October 2026, 09:30</time> · Šimon</span>
</li>
<li class="reminder">
<span class="reminder-text" id="reminder-3">Clean the fermenter</span>
<span class="reminder-meta">
<time datetime="2026-11-07T10:00">Saturday 7 November 2026, 10:00</time> · Ondra</span>
</li>
</ul>
</section>
</div>
</main>
