---
source: src/views/shopping.rs
expression: "editing_row(ItemId::from_client(2),\n&form(Purpose::Edit(ItemId::from_client(2)), values,\n&problems)).into_string().replace(\"><\", \">\\n<\")"
---
<li class="item editing" id="item-2">
<form class="entry-form" method="post" action="/shopping/2" hx-post="/shopping/2" hx-target="#open-items" hx-swap="outerHTML">
<div class="field">
<label for="item-2-edit-name">What's needed</label>
<input id="item-2-edit-name" type="text" name="name" value="  " required maxlength="200" autocomplete="off" aria-invalid="true" aria-describedby="item-2-edit-name-problem">
<p class="field-problem" id="item-2-edit-name-problem">Say what's needed.</p>
</div>
<fieldset class="field urgency-choice">
<legend>How soon</legend>
<div class="urgency-options">
<label class="urgency-option">
<input type="radio" name="urgency" value="asap" checked>ASAP</label>
<label class="urgency-option">
<input type="radio" name="urgency" value="next-brewday">Next brewday</label>
<label class="urgency-option">
<input type="radio" name="urgency" value="nice-to-have">Nice to have</label>
</div>
</fieldset>
<details class="field item-note-field" open>
<summary>Add a note</summary>
<label for="item-2-edit-note">Note <span class="optional">(optional)</span>
</label>
<textarea id="item-2-edit-note" name="note" rows="3" maxlength="500" aria-invalid="true" aria-describedby="item-2-edit-note-problem">Two packs of Saaz,
from the usual shop</textarea>
<p class="field-problem" id="item-2-edit-note-problem">Keep the note to 500 characters or fewer.</p>
</details>
<div class="edit-actions">
<button class="button" type="submit">Save Item</button>
<a class="button secondary" href="/shopping" hx-get="/shopping/2" hx-target="#item-2">Cancel</a>
<button class="button danger" type="submit" formaction="/shopping/2/delete" formnovalidate hx-post="/shopping/2/delete" hx-confirm="Delete this Item? It's gone for good.">Delete Item</button>
</div>
</form>
</li>
