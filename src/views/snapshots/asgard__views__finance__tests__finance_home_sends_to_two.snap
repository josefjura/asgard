</header>
<main class="shell-main">
<h1>Finance</h1>
<section class="card my-balance owes" aria-labelledby="my-balance">
<h2 id="my-balance">Your Balance</h2>
<p class="balance-figure">−300 Kč</p>
<p class="balance-says">You owe the Crew this.</p>
<p class="balance-next">Send Ondra <strong>200 Kč</strong> and Šimon <strong>100 Kč</strong>. <a href="#crew-balances">See Crew Balances</a>
</p>
</section>
<div class="finance-actions">
<a class="button large" href="/expenses/new">+ Expense</a>
<a class="button secondary" href="/payments/new">+ Payment</a>
</div>
<section class="section" aria-labelledby="latest-entries">
<h2 id="latest-entries">Latest entries</h2>
<p class="muted">Nothing logged yet. Log the first Expense when someone buys something for the brewery.</p>
</section>
<section class="section" aria-labelledby="crew-balances">
<h2 id="crew-balances">Crew Balances</h2>
<ul class="balance-list">
<li class="owes">
<span class="balance-name">Josef (you)</span>
<span class="balance-amount">−300 Kč</span>
<div class="balance-settlement">
<span class="balance-sends" id="settlement-0">Sends Ondra 200 Kč</span>
<a class="button small secondary" href="/payments/new?sender=1&amp;recipient=2&amp;amount=200" aria-describedby="settlement-0">I've sent it</a>
</div>
<div class="balance-settlement">
<span class="balance-sends" id="settlement-1">Sends Šimon 100 Kč</span>
<a class="button small secondary" href="/payments/new?sender=1&amp;recipient=3&amp;amount=100" aria-describedby="settlement-1">I've sent it</a>
</div>
</li>
<li class="owed">
<span class="balance-name">Ondra</span>
<span class="balance-amount">+200 Kč</span>
</li>
<li class="owed">
<span class="balance-name">Šimon</span>
<span class="balance-amount">+100 Kč</span>
</li>
</ul>
</section>
</main>
