---
source: src/views/invite.rs
expression: "signed_in(&name(\"Josef\"), LinkKind::Invite,\n\"/invite/abc/log-out\").into_string().replace(\"><\", \">\\n<\")"
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Already signed in | Asgard</title>
<meta name="theme-color" content="#3E5B2B" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#263820" media="(prefers-color-scheme: dark)">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="Asgard">
<link rel="manifest" href="/manifest.webmanifest">
<link rel="icon" type="image/svg+xml" href="/static/icon.[hash].svg">
<link rel="apple-touch-icon" href="/static/apple-touch-icon.[hash].png">
<link rel="stylesheet" href="/static/app.[hash].css">
<meta name="htmx-config" content="{&quot;responseHandling&quot;:[{&quot;code&quot;:&quot;204&quot;,&quot;swap&quot;:false},{&quot;code&quot;:&quot;[23]..&quot;,&quot;swap&quot;:true},{&quot;code&quot;:&quot;422&quot;,&quot;swap&quot;:true},{&quot;code&quot;:&quot;[45]..&quot;,&quot;swap&quot;:false,&quot;error&quot;:true},{&quot;code&quot;:&quot;...&quot;,&quot;swap&quot;:false}]}">
<script src="/static/htmx-2.0.11.min.[hash].js" defer>
</script>
<script type="module" src="/static/register-sw.[hash].js">
</script>
</head>
<body>
<main class="standalone">
<picture class="hero">
<source srcset="/static/logo-hero-dark.[hash].svg" media="(prefers-color-scheme: dark)">
<img src="/static/logo-hero-light.[hash].svg" alt="" width="180" height="180">
</picture>
<h1>You're already signed in</h1>
<p class="lead">This device is signed in as <strong>Josef</strong>.</p>
<p>This link is for someone joining the Crew. If it's meant for you on this device, log out first, then use the link.</p>
<form method="post" action="/invite/abc/log-out">
<button class="button" type="submit">Log out</button>
</form>
</main>
</body>
</html>
