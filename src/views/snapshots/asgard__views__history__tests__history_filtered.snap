<span class="entry-meta">Ondra paid · 28 October 2026</span>
</span>
<span class="entry-amount">12 480 Kč</span>
<svg class="chevron" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
<path d="M6 3l5 5-5 5">
</path>
</svg>
</a>
</li>
</ul>
</section>
