---
source: src/views/finance.rs
expression: "home(&member(JOSEF), &fresh()).into_string().replace(\"><\", \">\\n<\")"
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Finance | Asgard</title>
<meta name="theme-color" content="#3E5B2B" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#263820" media="(prefers-color-scheme: dark)">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="Asgard">
<link rel="manifest" href="/manifest.webmanifest">
<link rel="icon" type="image/svg+xml" href="/static/icon.[hash].svg">
<link rel="apple-touch-icon" href="/static/apple-touch-icon.[hash].png">
<link rel="stylesheet" href="/static/app.[hash].css">
<meta name="htmx-config" content="{&quot;responseHandling&quot;:[{&quot;code&quot;:&quot;204&quot;,&quot;swap&quot;:false},{&quot;code&quot;:&quot;[23]..&quot;,&quot;swap&quot;:true},{&quot;code&quot;:&quot;422&quot;,&quot;swap&quot;:true},{&quot;code&quot;:&quot;[45]..&quot;,&quot;swap&quot;:false,&quot;error&quot;:true},{&quot;code&quot;:&quot;...&quot;,&quot;swap&quot;:false}]}">
<script src="/static/htmx-2.0.11.min.[hash].js" defer>
</script>
<script type="module" src="/static/register-sw.[hash].js">
</script>
</head>
<body>
<div class="shell">
<header class="shell-header">
<a class="logo" href="/">
<img src="/static/logo-header.[hash].svg" alt="Asgard" width="128" height="32">
</a>
<a class="settings-link" href="/settings" aria-label="Settings">
<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
<circle cx="12" cy="12" r="3">
</circle>
<path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z">
</path>
</svg>
</a>
</header>
<main class="shell-main">
<h1>Finance</h1>
<section class="my-balance even" aria-labelledby="my-balance">
<h2 id="my-balance">Your Balance</h2>
<p class="balance-figure">Even</p>
<p class="balance-says">Nobody owes you and you owe nobody.</p>
</section>
<div class="finance-actions">
<a class="button button-large" href="/expenses/new">+ Expense</a>
<a class="button button-secondary" href="/payments/new">+ Payment</a>
</div>
<section class="finance-section" aria-labelledby="crew-balances">
<h2 id="crew-balances">Crew Balances</h2>
<ul class="balance-list">
<li class="even">
<span class="balance-name">Josef (you)</span>
<span class="balance-amount">Even</span>
</li>
<li class="even">
<span class="balance-name">Ondra</span>
<span class="balance-amount">Even</span>
</li>
<li class="even">
<span class="balance-name">Šimon</span>
<span class="balance-amount">Even</span>
</li>
</ul>
</section>
<section class="finance-section" aria-labelledby="settlement-plan">
<h2 id="settlement-plan">Settlement plan</h2>
<p class="lead-in">Nobody needs to send anything.</p>
</section>
<section class="finance-section" aria-labelledby="latest-entries">
<h2 id="latest-entries">Latest entries</h2>
<p class="lead-in">Nothing logged yet. Log the first Expense when someone buys something for the brewery.</p>
</section>
</main>
